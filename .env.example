# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/my_team?schema=public"

# Auth.js (NextAuth). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Magic-link email. In dev the link is logged to the server console, so these
# are unused. Set them when wiring a real transport (e.g. Resend) before launch.
# EMAIL_FROM="my-team <login@yourdomain.com>"
