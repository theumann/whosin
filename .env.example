# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/whosin?schema=public"

# Auth.js (NextAuth). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Invite-only sign-in. Comma-separated addresses allowed to request a magic
# link; anything else is refused before an email is sent. REQUIRED in
# production — if unset there, every sign-in is blocked (fail closed). Unset
# locally means anyone can sign in, which is fine for dev.
ALLOWED_EMAILS=""

# Local demo seed (npm run db:seed). Set this to the address you sign in with —
# the default is a placeholder, so leaving it unset seeds a roster belonging to
# a coach you can't log in as.
SEED_COACH_EMAIL=""

# Magic-link email. In dev (when RESEND_API_KEY is unset) the link is just
# logged to the server console. Set these to send real email via Resend's HTTP
# API (used instead of SMTP since Railway blocks outbound SMTP ports).
# EMAIL_FROM must be on a domain verified with Resend.
# RESEND_API_KEY=""
# EMAIL_FROM="whosin <login@contact.whosin.team>"

# Error monitoring (Sentry). Not secret — this is bundled into client code.
# Leave unset locally; errors just won't be reported.
# NEXT_PUBLIC_SENTRY_DSN=""

# Sentry source map uploads at build time (needs "project:releases" scope).
# Required in Railway's build environment; unset locally is fine — the build
# just skips the upload and falls back to unminified traces.
# SENTRY_AUTH_TOKEN=""
