# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/my_team?schema=public"

# Auth.js (NextAuth). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Magic-link email. In dev (when EMAIL_SERVER_HOST is unset) the link is just
# logged to the server console. Set these to send real email (e.g. via Resend's
# SMTP relay: host smtp.resend.com, port 465 or 587, user "resend", password is
# your Resend API key). EMAIL_FROM must be on a domain verified with the sender.
# EMAIL_SERVER_HOST="smtp.resend.com"
# EMAIL_SERVER_PORT="465"
# EMAIL_SERVER_USER="resend"
# EMAIL_SERVER_PASSWORD=""
# EMAIL_FROM="whosin <login@contact.whosin.team>"
