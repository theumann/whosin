# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/my_team?schema=public"

# Auth.js (NextAuth). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Magic-link email. In dev (when RESEND_API_KEY is unset) the link is just
# logged to the server console. Set these to send real email via Resend's HTTP
# API (used instead of SMTP since Railway blocks outbound SMTP ports).
# EMAIL_FROM must be on a domain verified with Resend.
# RESEND_API_KEY=""
# EMAIL_FROM="whosin <login@contact.whosin.team>"

# Error monitoring (Sentry). Not secret — this is bundled into client code.
# Leave unset locally; errors just won't be reported.
# NEXT_PUBLIC_SENTRY_DSN=""
